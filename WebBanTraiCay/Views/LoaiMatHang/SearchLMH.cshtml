@model IEnumerable<WebBanTraiCay.Models.loaimathang>
        @if (Model.Count() != 0)
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.maloai)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.tenloai)
                    </td>
                    <td class="col-actions">
                        @Html.ActionLink("Cập Nhật", "Edit", new { id = item.maloai }, new { @class = "btn btn-primary" }) |
                        @Html.ActionLink("Danh Sách Mặt Hàng", "Details", new { id = item.maloai }, new { @class = "btn btn-info" }) |
                        @Html.ActionLink("Xóa", "Delete", new { id = item.maloai }, new { @class = "btn btn-danger btn-delete", data_role = ViewBag.role })
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="3">Không có dữ liệu</td>
            </tr>
        }

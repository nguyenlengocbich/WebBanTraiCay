@model IEnumerable<WebBanTraiCay.Models.Sp_XemDHResult>

@{
    ViewBag.Title = "Đơn Hàng";
}
<style>
    .filter-section {
        padding: 20px;
        border: 1px solid #ccc;
        border-radius: 8px;
        max-width: 2000px;
        background-color: cornsilk;
        margin-bottom: 20px;
    }

        .filter-section h3 {
            margin-bottom: 20px;
            font-size: 20px;
            color: #333;
        }

    .filter-row-horizontal-wide {
        display: flex;
        justify-content: space-between;
        gap: 30px;
        flex-wrap: wrap;
        align-items: center;
    }

    .filter-inline-wide {
        display: flex;
        align-items: center;
        gap: 10px;
        flex: 1;
        min-width: 250px;
    }

        .filter-inline-wide label {
            font-weight: 500;
            color: #555;
            white-space: nowrap;
            min-width: 100px;
        }

        .filter-inline-wide input,
        .filter-inline-wide select {
            width: 100%;
            padding: 10px;
            border-radius: 6px;
            border: 1px solid #ccc;
            font-size: 14px;
        }

    .search {
        width: 100% !important;
        padding: 8px;
        border-radius: 6px;
        border: 1px solid #ccc;
        flex: 1;
        font-size: 14px
    }
</style>
<h2>Danh Sách Đơn Hàng</h2>
<div class="filter-section">
    <h3>Lọc Dữ Liệu</h3>
    <div class="filter-row-horizontal-wide">
        <div class="filter-inline-wide">
            <label for="dateFrom">Ngày bán từ:</label>
            <input id="dateFrom" name="dateFrom" type="date" />
        </div>
        <div class="filter-inline-wide">
            <label for="dateTo">đến:</label>
            <input id="dateTo" name="dateTo" type="date" />
        </div>
        <div class="filter-inline-wide">
            <label for="selectTinhTrang">Tình trạng:</label>
            <select id="selectTinhTrang" name="selectTinhTrang" style="text-align:center">
                <option value="">-- Tất cả --</option>
                <option value="Chờ xử lý">Chờ xử lý</option>
                <option value="Đang giao hàng">Đang giao hàng</option>
                <option value="Đã thanh toán">Đã thanh toán</option>
                <option value="Đã hủy">Đã hủy</option>
            </select>
        </div>
    </div>
</div>
<div class="row" style="display: flex; justify-content: space-between; align-items: center; gap: 20px; margin-bottom: 20px;">
    <div id="search" style="flex: 1;">
        <label for="textsearch">Tìm kiếm:</label>
        <input class="search" required id="textsearch" name="textsearch" type="text" placeholder="Nhập tên khách hàng" />
    </div>
    <div class="col-md-2">
        <button onclick="location.href='@Url.Action("Create", "DonHang")'" style="padding: 10px 16px; background-color: #007bff; color: white; border: none;border-radius: 6px; font-weight: bold; cursor: pointer; white-space: nowrap;">
            Thêm Đơn Hàng Mới
        </button>
    </div>
</div>
@if (TempData["ThongBao"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>@TempData["ThongBao"]</strong>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close">
        </button>
    </div>
}
<div id="dhtable">
    <table id="myTable" class="display table table-bordered table-striped" style="text-align: center; vertical-align: middle;font-family:Arial, sans-serif">
        <thead>
            <tr class="table-primary" style="color:crimson">
                <th>
                    Mã Đơn Hàng
                </th>
                <th>
                    Ngày Bán
                </th>
                <th>
                    Tên Khách Hàng
                </th>
                <th>
                    Nhân Viên Lập
                </th>
                <th>
                    Trạng Thái
                </th>
                <th>
                    Phương Thức Thanh Toán
                </th>
                <th class="col-actions">
                    Thao Tác
                </th>
            </tr>
        </thead>
        <tbody id="tbody">
            @Html.Action("SearchDH")
        </tbody>
    </table>
</div>
@section scripts {
    <script>
        $(document).ready(function () {
            function search() {
                const keyword = $('#textsearch').val();
                const dateFrom = $('#dateFrom').val();
                const dateTo = $('#dateTo').val();
                const tinhtrang = $('#selectTinhTrang').val();
                $.ajax({
                    url: '@Url.Action("SearchDH", "DonHang")',
                    type: 'POST',
                    data: {
                        txtsearch: keyword,
                        dateFrom: dateFrom,
                        dateTo: dateTo,
                        tinhtrang: tinhtrang
                    },
                    success: function (result) {
                        $('#tbody').html(result);
                    }
                });
            }
            $('#textsearch').on('keyup', search);
            $('#dateFrom, #dateTo').on('change', search);
            $('#selectTinhTrang').on('change', search);
        });
    </script>
}

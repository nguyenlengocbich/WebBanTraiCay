@model IEnumerable<WebBanTraiCay.Models.sp_XemMhResult>
        @if (Model.Count() != 0)
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.mamh)
                    </td>
                    <td class="col-wrap">
                        @Html.DisplayFor(modelItem => item.tenmh)
                    </td>
                    <td class="col-wrap">
                        @Html.DisplayFor(modelItem => item.tenloai)
                    </td>
                    <td class="col-number">
                        @Html.DisplayFor(modelItem => item.soluong)
                    </td>
                    <td class="col-number">
                        @Html.DisplayFor(modelItem => item.giaban)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.dvtinh)
                    </td>
                    <td class="col-image">
                        <img src="~/Hinh/@Url.Content(item.hinhanhmh)" alt="image" style="width:100px;height:100px" />
                    </td>
                    <td style="background-color:@(item.tinhtrang == "Còn hàng" ? "#00ff0096" : "#fb0000f2")">
                        @Html.DisplayFor(modelItem => item.tinhtrang)
                    </td>
                    <td class="col-actions">
                        @Html.ActionLink("Cập Nhật", "Edit", new { id = item.mamh }, new { @class = "btn btn-primary" }) |
                        @Html.ActionLink("Chi Tiết", "Details", new { id = item.mamh }, new { @class = "btn btn-info" }) |
                        @Html.ActionLink("Xóa", "Delete", new { id = item.mamh }, new { @class = "btn btn-danger btn-delete", data_role = ViewBag.role })
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="9">Không có dữ liệu</td>
            </tr>
        }
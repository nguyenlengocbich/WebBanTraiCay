@model WebBanTraiCay.Models.mathang
@{
    ViewBag.Title = "Thêm Mặt Hàng";
}
<style>
    .form-group {
        padding-left: 20%;
        padding-right: 20%;
        align-items: center;
    }
    .form-horizontal {
        font-size: 20px;
    }
    .form-horizontal .col-md-9 .form-control {
        width: 80% !important;
        box-sizing: border-box;
        max-width: 80% !important;
    }
</style>
<h2>Thêm Mặt Hàng</h2>

@using (Html.BeginForm("Create", "MatHang", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal" style="background-color:cornsilk">
        <h4 style="text-align:center;padding-top:10px">Mặt Hàng</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="form-group row mb-3">
            <label class="control-label col-md-3">Tên Mặt Hàng</label>
            <div class="col-md-9">
                @Html.EditorFor(model => model.tenmh, new { htmlAttributes = new { @class = "form-control", style = "font-size:20px",@required="required" } })
                @Html.ValidationMessageFor(model => model.tenmh, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group row mb-3">
            <label class="control-label col-md-3">Loại Mặt Hàng</label>
            <div class="col-md-9">
                @Html.DropDownListFor(m => m.maloai, (SelectList)ViewBag.loaimh, new { @class = "form-control", style = "font-size:20px" })
                @Html.ValidationMessageFor(m => m.maloai)
            </div>
        </div>

        <div class="form-group row mb-3">
            <label class="control-label col-md-3">Số Lượng</label>
            <div class="col-md-9">
                @Html.EditorFor(model => model.soluong, new { htmlAttributes = new { @class = "form-control", style = "font-size:20px", @min = "1", @type = "number" } })
                @Html.ValidationMessageFor(model => model.soluong, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group row mb-3">
            <label class="control-label col-md-3">Giá Bán</label>
            <div class="col-md-9">
                @Html.EditorFor(model => model.giaban, new { htmlAttributes = new { @class = "form-control", style = "font-size:20px", @min = "1", @type = "number" } })
                @Html.ValidationMessageFor(model => model.giaban, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group row mb-3">
            <label class="control-label col-md-3">Đơn Vị Tính</label>
            <div class="col-md-9">
                @Html.EditorFor(model => model.dvtinh, new { htmlAttributes = new { @class = "form-control", style = "font-size:20px",@required = "required" } })
                @Html.ValidationMessageFor(model => model.dvtinh, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group row mb-3" style="align-items:center">
            <label class="control-label col-md-3">Hình Ảnh Mặt Hàng</label>
            <div class="col-md-9">
                <input class="form-control" required title="Up load hình ảnh sản phẩm" type="file" name="hinhanhmh" />
                @Html.ValidationMessageFor(model => model.hinhanhmh, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group row mb-3">
            <label class="control-label col-md-3">Mô Tả</label>
            <div class="col-md-9">
                @Html.TextAreaFor(model => model.mota, new { htmlAttributes = new { @class = "form-control", style = "font-size:20px" }, rows = 4, cols = 800 })
                @Html.ValidationMessageFor(model => model.mota, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group row mb-3" style="align-items:center;padding-bottom:20px">
            <div class="col-md-6"></div>
            <div class="col-md-offset-2 col-md-2 form-control-sm">
                <input style="font-size:20px" type="submit" value="Thêm" class="btn btn-success" />
            </div>
        </div>
    </div>
}

<div>
    @Html.ActionLink("Trở về danh sách", "Index")
</div>

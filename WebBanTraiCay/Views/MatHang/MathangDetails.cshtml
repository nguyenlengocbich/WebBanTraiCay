@model IEnumerable<WebBanTraiCay.Models.sp_mathangdetailsResult>
<table class="table table-bordered table-striped" style="text-align: center; vertical-align: middle;font-family:Arial, sans-serif">
    <tr class="table-primary" style="color:crimson">
        <th>
            Mã Đơn Hàng
        </th>
        <th>
            Tên Mặt Hàng
        </th>
        <th>
            Mã Khách Hàng
        </th>
        <th>
            Ngày Bán
        </th>
        <th>
            Số Lượng
        </th>
        <th>
            Đơn giá
        </th>
        <th>
            Thành Tiền
        </th>
    </tr>
    @if (Model.Count() != 0)
    {
        foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.madh)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.tenmh)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.makh)
                </td>
                <td>
                    @item.ngayban.ToString("dd/MM/yyyy")
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.sl)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.gb)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.thanhtien)
                </td>
            </tr>
        }
    }
    else
    {
        <tr>
            <td colspan="7">Không có dữ liệu</td>
        </tr>
    }
</table>

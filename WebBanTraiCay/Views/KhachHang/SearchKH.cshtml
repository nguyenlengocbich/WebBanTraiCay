@model IEnumerable<WebBanTraiCay.Models.khachhang>
    @if (Model.Count() != 0)
    {
        foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.makh)
                </td>
                <td class="col-wrap">
                    @Html.DisplayFor(modelItem => item.tenkh)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.sdt)
                </td>
                <td class="col-wrap">
                    @Html.DisplayFor(modelItem => item.diachi)
                </td>
                <td class="col-actions">
                    @Html.ActionLink("Cập Nhật", "Edit", new { id = item.makh }, new { @class = "btn btn-primary" }) |
                    @Html.ActionLink("Chi Tiết", "Details", new { id = item.makh }, new { @class = "btn btn-info" }) |
                    @Html.ActionLink("Xóa", "Delete", new { id = item.makh }, new { @class = "btn btn-danger btn-delete", data_role = ViewBag.role })
                </td>
            </tr>
        }
    }
    else
    {
        <tr>
            <td colspan="5">Không có dữ liệu</td>
        </tr>
    }

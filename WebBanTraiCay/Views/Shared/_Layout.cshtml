<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - MuiNeFruit</title>
    <link href="~/Content/dataTables.bootstrap5.css" rel="stylesheet" />
    @Styles.Render("~/Content/css")
    <link href="~/Content/font-awesome-4.7.0/css/font-awesome.min.css" rel="stylesheet" />
    <script src="~/Scripts/apexcharts.js"></script>
    @Scripts.Render("~/bundles/modernizr")
    <style>
        body {
            font-family: Arial sans-serif;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .body-content {
            flex: 1;
        }

        .nav-link {
            transition: color 0.3s ease, background-color 0.3s ease;
        }

            .nav-link:hover {
                color: #ffffff !important;
                background-color: #1b5e20;
                border-radius: 5px;
            }

        .xinchao {
            font-size: 17px;
            color: #1b5e20;
        }

        html, body {
            height: 100%;
            margin: 0;
        }

        .dropdown-menu {
            min-width: 230px !important;
        }

        footer {
            background-color: #a8e6cf;
            text-align: center;
            padding: 3px 0;
            color: #1b5e20;
            font-weight: 500;
            border-top: 2px solid #81c784;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light" style="background-color: #a8e6cf;">
        <div class="container-fluid px-5 d-flex align-items-center">
            <a class="navbar-brand me-0 d-flex align-items-center" href="@Url.Action("Index", "Home")">
                <img src="~/Hinh/logo.jpg" alt="Logo" style="width:100px; height: 50px; margin-right: 5px;" />
                <span class="fw-bold" style="color:#2e7d32; font-size:30px;">MuiNeFruit</span>
            </a>
            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#mainNavbarContent"
                    aria-controls="mainNavbarContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNavbarContent">
                <ul class="navbar-nav w-auto me-auto pt-2 pt-lg-0 align-items-center">
                    <li class="nav-item px-1">@Html.ActionLink("Trang chủ", "Index", "Home", new { area = "" }, new { @class = "nav-link fw-semibold", style = "color:#1b5e20;font-size:17px" })</li>
                    <li class="nav-item px-1">@Html.ActionLink("Mặt hàng", "Index", "MatHang", new { area = "" }, new { @class = "nav-link fw-semibold", style = "color:#1b5e20;font-size:17px" })</li>
                    <li class="nav-item px-1">@Html.ActionLink("Loại mặt hàng", "Index", "LoaiMatHang", new { area = "" }, new { @class = "nav-link fw-semibold", style = "color:#1b5e20;font-size:17px" })</li>
                    <li class="nav-item px-1">@Html.ActionLink("Phiếu nhập", "Index", "PhieuNhap", new { area = "" }, new { @class = "nav-link fw-semibold", style = "color:#1b5e20;font-size:17px" })</li>
                    <li class="nav-item px-1">@Html.ActionLink("Nhà cung cấp", "Index", "NhaCungCap", new { area = "" }, new { @class = "nav-link fw-semibold", style = "color:#1b5e20;font-size:17px" })</li>
                    <li class="nav-item px-1">@Html.ActionLink("Khách hàng", "Index", "KhachHang", new { area = "" }, new { @class = "nav-link fw-semibold", style = "color:#1b5e20;font-size:17px" })</li>
                    <li class="nav-item px-1">@Html.ActionLink("Đơn hàng", "Index", "DonHang", new { area = "" }, new { @class = "nav-link fw-semibold", style = "color:#1b5e20;font-size:17px" })</li>
                    @if (ViewBag.role != null && ViewBag.role == "admin")
                    {
                        <li class="nav-item px-1">@Html.ActionLink("Nhân viên", "Index", "NhanVien", new { area = "" }, new { @class = "nav-link fw-semibold", style = "color:#1b5e20;font-size:17px" })</li>
                    }
                    <li class="nav-item px-1">@Html.ActionLink("Thống kê", "Index", "ThongKe", new { area = "" }, new { @class = "nav-link fw-semibold", style = "color:#1b5e20;font-size:17px" })</li>
                </ul>
                <ul class="navbar-nav ms-auto align-items-center">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item dropdown px-1">
                            <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <img src="@Url.Content("~/HinhNV/" + ViewBag.avatar)" alt="Avatar" class="avatar rounded-circle me-2" title="@User.Identity.Name">
                                <span class="d-sm-inline-block" style="font-size: 17px">Xin chào! @User.Identity.Name</span>
                            </a>
                            <div class="dropdown-menu dropdown-menu-right" aria-labelledby="userDropdown">
                                <div class="px-3 py-2">
                                    <img src="@Url.Content("~/HinhNV/" + ViewBag.avatar)" class="avatar-large rounded-circle mb-2" alt="Avatar">
                                    <p style="font-size: 17px;text-align:center;margin-bottom:0px">@ViewBag.hoten</p>
                                </div>
                                <div class="dropdown-divider"></div>
                                <a class="dropdown-item" href="@Url.Action("NVProfile", "Account")">
                                    <i class="fa fa-user"></i> Xem Profile
                                </a>
                                <a class="dropdown-item" href="@Url.Action("PasswordChange", "Account")">
                                    <i class="fa fa-cog"></i> Đổi mật khẩu
                                </a>
                                @if (ViewBag.role != null && (ViewBag.role == "admin" || ViewBag.role == "nv"))
                                {
                                    <a class="dropdown-item" href="@Url.Action("Index", "MuiNeFruit")">
                                        <i class="fa fa-exchange"></i> Trang giao diện
                                    </a>
                                }
                                @if (ViewBag.role != null && ViewBag.role == "admin")
                                {
                                    <a class="dropdown-item" href="@Url.Action("BackupRestore", "Home")">
                                        <i class="fa fa-database"></i> Sao lưu & Phục hồi
                                    </a>
                                }
                                <div class="dropdown-divider"></div>
                                <a class="dropdown-item" href="@Url.Action("Logout", "Account")">
                                    <i class="fa fa-sign-out"></i> Đăng xuất
                                </a>
                            </div>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item px-1">
                            @Html.ActionLink("Đăng nhập", "Login", "Account", new { area = "" }, new { @class = "nav-link fw-semibold", style = "color:#1b5e20;font-size:17px" })
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
    <div class="container body-content">
        @RenderBody()
        <hr />
    </div>
    <footer>
        <p style="font-size:17px; margin:10px">&copy; @DateTime.Now.Year - Nhóm 1-K15THO2</p>
    </footer>
    @Scripts.Render("~/bundles/jquery")
    <script src="~/Scripts/bootstrap.bundle.min.js"></script>
    <script src="~/Scripts/dataTables.js"></script>
    <script src="~/Scripts/dataTables.bootstrap5.js"></script>
    <link href="~/Content/responsive.dataTables.min.css" rel="stylesheet" />
    <script src="~/Scripts/dataTables.responsive.min.js"></script>
    <script src="~/Scripts/responsive.bootstrap5.min.js"></script>
    <script src="~/Scripts/sweetalert2@11.js"></script>
    <script>
        function initDataTable() {
            if ($.fn.DataTable.isDataTable('#myTable')) {
                $('#myTable').DataTable().destroy();
            }
            $('#myTable').DataTable({
                scrollX: true,
                autoWidth: false,
                searching: false,
                paging: true,
                lengthChange: true,
                order: [[0, 'asc']],
                columnDefs: [
                    { targets: 'col-actions', orderable: false, searchable: false, className: 'no-wrap' },
                    { targets: 'col-number', className: 'dt-body-right no-wrap' },
                    { targets: 'col-image', orderable: false, searchable: false, className: 'no-wrap' },
                    { targets: 'col-wrap', className: 'wrap-text' }
                ]
            });
        }
    </script>
    @RenderSection("scripts", required: false)
    <script>
        $(document).ready(function () {
            initDataTable();
        });
    </script>
    <script>
        $(document).on("click", ".btn-delete", function (e) {
            const role = $(this).data("role");
            if (role !== "admin") {
                e.preventDefault();
                alert("Chỉ ADMIN mới được phép sử dụng chức năng này!");
                return false;
            }
            return confirm("Bạn có chắc muốn xóa không?");
        });
    </script>
    @if (TempData["SuccessMessage"] != null)
    {
        <script>
            Swal.fire({
                title: 'Thành công!',
                text: '@Html.Raw(@TempData["SuccessMessage"])',
                icon: 'success',
                confirmButtonText: 'Đồng ý',
                timer: 5000,
                timerProgressBar: true
            });
        </script>
    }
</body>
</html>

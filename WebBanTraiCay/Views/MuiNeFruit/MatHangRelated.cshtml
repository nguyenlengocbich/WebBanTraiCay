@model IEnumerable<WebBanTraiCay.Models.mathang>
<!-- Related Product Start -->
<div class="container-fluid related-product">
    <div class="container">
        <div class="mx-auto text-center pb-5" style="max-width: 700px;">
            <h4 class="text-primary mb-4 border-bottom border-primary border-2 d-inline-block p-2 title-border-radius wow fadeInUp"
                data-wow-delay="0.1s">
                Sản phẩm liên quan
            </h4>
        </div>
        <div class="related-carousel owl-carousel pt-4">
            @if (Model.Count() != 0)
            {
                foreach (var a in Model)
                {
                    string tenloai = (ViewBag.loai as List<WebBanTraiCay.Models.loaimathang>).FirstOrDefault(x => x.maloai == a.maloai).tenloai;
                    <div class="related-item rounded">
                        <div class="related-item-inner border rounded">
                            <div class="related-item-inner-item">
                                <img src="~/Hinh/@Url.Content(a.hinhanhmh)" class="img-fluid w-100 rounded-top" alt="@a.tenmh">
                                <div class="related-details">
                                    @using (Html.BeginForm("MatHangDetail", "MuiNeFruit", new { id = a.mamh }, FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" style="background: none; border: none; padding: 0; color: inherit; outline: none;">
                                            <i class="fa fa-eye fa-1x "></i>
                                        </button>
                                    }
                                </div>
                            </div>
                            <div class="text-center p-4 rounded-bottom p-4">
                                <a href="javascript:void(0)" class="d-block text-warning">@tenloai</a>
                                <h6 class="d-block text-dark" style="min-height: 1.5em; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                                    @a.tenmh
                                </h6>
                                <span class="text-muted me-2">Đơn vị tính: @a.dvtinh</span>
                                <div class="mt-auto">
                                    <span class="text-muted me-2">Số Lượng: @a.soluong</span>
                                    <span class="text-secondary fw-bold">@a.giaban.ToString("#,##0") VNĐ</span>
                                </div>
                            </div>
                            <div class="text-center p-4 pt-0">
                                @if (a.soluong > 0)
                                {
                                    <a href="#" class="btn btn-primary border-secondary rounded-pill py-2 px-4 w-100 js-addcart"
                                       data-id="@a.mamh" data-name="@a.tenmh">
                                        <i class="fa fa-shopping-cart me-2"></i> Thêm vào giỏ hàng
                                    </a>
                                }
                                else
                                {
                                    <a href="javascript:void(0)" class="btn btn-secondary rounded-pill py-2 px-4 w-100 disabled">
                                        Hết hàng
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>
<!-- Related Product End -->
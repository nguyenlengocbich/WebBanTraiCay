@model IEnumerable<WebBanTraiCay.Models.mathang>
<div class="tab-content">
    <div id="tab-5" class="tab-pane fade p-0 ">
        <div class="row g-4 product">
            @if (Model.Count() != 0)
            {
                double temp = 0.1;
                foreach (var a in Model)
                {
                    string tenloai = (ViewBag.loai as List<WebBanTraiCay.Models.loaimathang>).FirstOrDefault(x => x.maloai == a.maloai).tenloai;
                    <div class="col-lg-4">
                        <div class="product-item rounded wow fadeInUp h-100" data-wow-delay="@(temp + "s")">
                            <div class="product-item-inner border rounded d-flex flex-column h-100">
                                <div class="product-item-inner-item">
                                    <img src="~/Hinh/@Url.Content(a.hinhanhmh)" class="img-fluid w-100 rounded-top" alt="@a.tenmh">
                                    <div class="product-@ViewBag.loaiload">@ViewBag.loaiload</div>
                                    <div class="product-details">
                                        @using (Html.BeginForm("MatHangDetail", "MuiNeFruit", new { id = a.mamh }, FormMethod.Post))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="submit" style="background: none; border: none; padding: 0; color: inherit; outline: none;">
                                                <i class="fa fa-eye fa-1x "></i>
                                            </button>
                                        }
                                    </div>
                                </div>
                                <div class="text-center p-4 flex-grow-1 d-flex flex-column">
                                    <a href="javascript:void(0)" class="d-block mb-2 text-warning">@tenloai</a>
                                    <h6 class="d-block text-dark" style="min-height: 1.5em; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                                        @a.tenmh
                                    </h6>
                                    <span class="text-muted me-2">Đơn vị tính: @a.dvtinh</span>
                                    <div class="mt-auto">
                                        <span class="text-muted me-2">Số Lượng: @a.soluong</span>
                                        <span class="text-secondary fw-bold">@a.giaban.ToString("#,##0") VNĐ</span>
                                    </div>
                                </div>
                                <div class="text-center p-4 pt-0">
                                    @if (a.soluong > 0)
                                    {
                                        <a href="#" class="btn btn-primary border-secondary rounded-pill py-2 px-4 w-100 js-addcart"
                                           data-id="@a.mamh" data-name="@a.tenmh">
                                            <i class="fa fa-shopping-cart me-2"></i> Thêm vào giỏ hàng
                                        </a>
                                    }
                                    else
                                    {
                                        <a href="javascript:void(0)" class="btn btn-secondary rounded-pill py-2 px-4 w-100 disabled">
                                            Hết hàng
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    temp += 0.2;
                }
            }
            @if (ViewBag.TotalPages > 1)
            {
                <div class="col-12 wow fadeInUp" data-wow-delay="0.1s">
                    <div class="pagination d-flex justify-content-center mt-5">
                        @if (ViewBag.CurrentPage > 1)
                        {
                            <a href="javascript:void(0)" data-page="@(ViewBag.CurrentPage - 1)" class="rounded">&laquo;</a>
                        }
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <a href="javascript:void(0)"
                               data-page="@i"
                               class="rounded @(i == ViewBag.CurrentPage ? "active" : "")">
                                @i
                            </a>
                        }
                        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                        {
                            <a href="javascript:void(0)" data-page="@(ViewBag.CurrentPage + 1)" class="rounded">&raquo;</a>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
    <div id="tab-6" class="products tab-pane fade p-0">
        <div class="row g-4 products-mini">
            @if (Model.Count() != 0)
            {
                foreach (var a in Model)
                {
                    string tenloai = (ViewBag.loai as List<WebBanTraiCay.Models.loaimathang>).FirstOrDefault(x => x.maloai == a.maloai).tenloai;
                    <div class="col-lg-6">
                        <div class="products-mini-item border">
                            <div class="row g-0">
                                <div class="col-5">
                                    <div class="products-mini-img border-end h-100">
                                        <img src="~/Hinh/@Url.Content(a.hinhanhmh)" class="img-fluid w-100 h-100"
                                             alt="Image">
                                        <div class="product-details">
                                            @using (Html.BeginForm("MatHangDetail", "MuiNeFruit", new { id = a.mamh }, FormMethod.Post))
                                            {
                                                <button type="submit" style="background: none; border: none; padding: 0; color: inherit; outline: none;">
                                                    <i class="fa fa-eye fa-1x "></i>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="col-7">
                                    <div class="products-mini-content p-3">
                                        <a href="javascript:void(0)" class="d-block mb-2 text-warning">@tenloai</a>
                                        <h6 class="d-block text-dark" style="min-height: 1.5em; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                                            @a.tenmh
                                        </h6>
                                        <span class="text-muted me-2">Đơn vị tính: @a.dvtinh</span>
                                        <div class="mt-auto">
                                            <span class="text-muted me-2">Số Lượng: @a.soluong</span>
                                            <span class="text-secondary fw-bold">@a.giaban.ToString("#,##0") VNĐ</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="products-mini-add border p-3">
                                @if (a.soluong > 0)
                                {
                                    <a href="#" class="btn btn-primary border-secondary rounded-pill py-2 px-4 w-100 js-addcart"
                                       data-id="@a.mamh" data-name="@a.tenmh">
                                        <i class="fa fa-shopping-cart me-2"></i> Thêm vào giỏ hàng
                                    </a>
                                }
                                else
                                {
                                    <a href="javascript:void(0)" class="btn btn-secondary rounded-pill py-2 px-4 w-100 disabled">
                                        Hết hàng
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
            @if (ViewBag.TotalPages > 1)
            {
                <div class="col-12 wow fadeInUp" data-wow-delay="0.1s">
                    <div class="pagination d-flex justify-content-center mt-5">
                        @if (ViewBag.CurrentPage > 1)
                        {
                            <a href="javascript:void(0)" data-page="@(ViewBag.CurrentPage - 1)" class="rounded">&laquo;</a>
                        }
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <a href="javascript:void(0)"
                               data-page="@i"
                               class="rounded @(i == ViewBag.CurrentPage ? "active" : "")">
                                @i
                            </a>
                        }
                        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                        {
                            <a href="javascript:void(0)" data-page="@(ViewBag.CurrentPage + 1)" class="rounded">&raquo;</a>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@{
    ViewBag.Title = "TKDT";
}
@section Scripts{
    <script>
document.addEventListener('DOMContentLoaded', function () {
	    const mangmh = @Html.Raw(ViewBag.tenmh);
        const doanhthu = @Html.Raw(ViewBag.doanhthumh);
	    const tenmhht = [];
	    for (var i = 0; i < mangmh.length; i++) {
            const tenmh = mangmh[i];
            const cactu = tenmh.split(' ');
            if (cactu.length > 1) {
                const dau = cactu.slice(0, Math.ceil(cactu.length / 3)).join(' ');
                const giua = cactu.slice(Math.ceil(cactu.length / 3),Math.ceil(cactu.length / 3)*2).join(' ');
                const sau = cactu.slice(Math.ceil(cactu.length / 3)*2).join(' ');
                tenmhht.push([dau,giua, sau]);
            } else {
                tenmhht.push([tenmh]);
            }
        };
        var options1 = {
            chart: { type: 'bar', height: 315, fontFamily: 'Verdana, sans-serif',style:{fontSize:'13px'} },
            series: [{ name: 'Doanh Thu', data: doanhthu}],
            xaxis: { categories: tenmhht,title: {text: 'Doanh Thu'},labels: {rotate: 0, style:{fontSize:'11px'}}},
		    yaxis: {title: {text: 'Tên Mặt Hàng'}},
		    plotOptions: {bar: {horizontal: true}},
		    tooltip: {x: { formatter: function(val) {return val;}}},
        };
        new ApexCharts(document.querySelector("#chart_divmh"), options1).render();
        const pieloai = @Html.Raw(ViewBag.pieloai);
        const piesll = @Html.Raw(ViewBag.piesll);
        var options3 = {
            chart: { type: 'pie', height: 307, fontFamily: 'Verdana, sans-serif' },
            series: piesll,
            labels: pieloai,
        };
    new ApexCharts(document.querySelector("#chart_divlmh"), options3).render();
    function thongke() {
        var id = $("#tkdt").val();;
        $.ajax({
            url: '@Url.Action("TKDT", "ThongKe")',
            type: 'POST',
            data: {
                id : id
            },
            success: function (result) {
                $("#chart_divthang").html("");
                var options4 = {
                    chart: {
                        type: 'line', fontFamily: 'Verdana, sans-serif',height: 600,toolbar: {tools: {selection: false,zoom: false,zoomin: false,zoomout: false,pan: false,reset: false}},
                            zoom: { enabled: false }},
                    series: result.series,
                    xaxis: {
                        categories: result.ltk
                    },
                    yaxis: {
                        title: {
                            text: 'Doanh thu'
                        },
                        labels: {formatter: function (val) {return val.toLocaleString('vi-VN') + " VNĐ";}
                        }
                    },
                    stroke: {
                        width: 3,
                        curve: 'straight'
                    },
                    markers: {
                        size: 5
                    },
                    dataLabels: {
                        enabled: false
                    },
                    tooltip: {
                        y: {formatter: function (val) {return val.toLocaleString('vi-VN') + " VNĐ";}}
                    },
                    legend: {
                        position: 'top'
                    }
                };
                new ApexCharts(document.querySelector("#chart_divthang"),options4).render();
            }
    });
    };
    $("#tkdt").change(function () {
        $("#tkdt_hidden").val($(this).val());
    });
    $("#tkdt_hidden").val($("#tkdt").val());
    thongke();
    $("#tkdt").change(thongke);
    });
    </script>
}
<div class="container">
    <div class="page-inner">
        <div class="row">
            <div class="d-flex col-md-9 align-items-left align-items-md-center flex-column flex-md-row pt-2 pb-4">
                <div style="vertical-align: middle">
                    <h3 class="fw-bold mb-3">Thống kê doanh thu</h3>
                </div>
            </div>
            <div class="col-md-3" style="text-align: right; vertical-align: middle">
                @Html.ActionLink("Quay Lại", "Index")
            </div>
        </div>
        <div class="row row-card-no-pd">
            <div class="col-12 col-sm-6 col-md-6 col-xl-4">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between" style="align-items:center">
                            <div>
                                <h6><b>Lợi nhuận trong tháng</b></h6>
                            </div>
                            <h5 class="text-info fw-bold">@ViewBag.lnt VNĐ</h5>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-md-6 col-xl-4">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between" style="align-items:center">
                            <div>
                                <h6><b>Doanh thu trong tháng</b></h6>
                            </div>
                            <h5 class="text-success fw-bold">@ViewBag.dtt VNĐ</h5>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-md-6 col-xl-4">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between" style="align-items:center">
                            <div>
                                <h6><b>Chi tiêu nhập hàng trong tháng</b></h6>
                            </div>
                            <h5 class="text-danger fw-bold">@ViewBag.pnt VNĐ</h5>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="col-md-7">
                <div class="card">
                    <div class="card-header"><h5>Biểu Đồ Top 5 Mặt Hàng Có Doanh Thu Cao Nhất Trong Tháng</h5></div>
                    <div class="card-body">
                        <div id="chart_divmh" style="width: 100%; height:300px; max-width:100%; margin:auto"></div>
                    </div>
                </div>
            </div>
            <div class="col-md-5">
                <div class="card">
                    <div class="card-header"><h5>Biểu Đồ Doanh Thu Trong Tháng Theo Loại Mặt Hàng</h5></div>
                    <div class="card-body">
                        <div id="chart_divlmh" style="width: 100%; height:315px; max-width:100%; margin:auto"></div>
                    </div>
                </div>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <div class="row">
                            <div class="col-md-10">
                                <select id="tkdt" class="form-control select-tk" style="font-size: 1.25rem;text-align:center;min-width: 100%; border: none; background-color: inherit">
                                    <option value="dtt" style="font-size: 1.25rem">Biểu Đồ Doanh Thu Theo Từng Tháng</option>
                                    <option value="dtq" style="font-size: 1.25rem">Biểu Đồ Doanh Thu Theo Từng Quý</option>
                                    <option value="dtn" style="font-size: 1.25rem">Biểu Đồ Doanh Thu Trong 5 Năm Gần Đây</option>
                                </select>
                            </div>
                            <div class="col-md-2" style="text-align:right">
                                @using (Html.BeginForm("DowloadDT", "ThongKe", FormMethod.Get))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" id="tkdt_hidden" />
                                    <button type="submit" class="btn btn-success">
                                        <i class="fa fa-download"></i> Xuất báo cáo
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div id="chart_divthang" style="width: 100%; height:400px; max-width:100%; margin:auto"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


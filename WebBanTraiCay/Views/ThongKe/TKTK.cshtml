
@{
    ViewBag.Title = "TKTK";
}
@section Scripts{
    <script>
    document.addEventListener('DOMContentLoaded', function () {
	        const mangmh = @Html.Raw(ViewBag.tenmh);
            const slton = @Html.Raw(ViewBag.soluongton);
	        const tenmhht = [];
	        for (var i = 0; i < mangmh.length; i++) {
                const tenmh = mangmh[i];
                const cactu = tenmh.split(' ');
                if (cactu.length > 1) {
                    const dau = cactu.slice(0, Math.ceil(cactu.length / 3)).join(' ');
                    const giua = cactu.slice(Math.ceil(cactu.length / 3),Math.ceil(cactu.length / 3)*2).join(' ');
                    const sau = cactu.slice(Math.ceil(cactu.length / 3)*2).join(' ');
                    tenmhht.push([dau,giua, sau]);
                } else {
                    tenmhht.push([tenmh]);
                }
            };
            var options1 = {
                chart: { type: 'bar', height: 315, fontFamily: 'Verdana, sans-serif',style:{fontSize:'13px'} },
                series: [{ name: 'Số Lượng Tồn', data: slton }],
                xaxis: { categories: tenmhht, title: { text: 'Số Lượng Tồn'},labels: {rotate: 0, style:{fontSize:'11px'}}},
		        yaxis: {title: {text: 'Tên Mặt Hàng'}},
		        plotOptions: {bar: {horizontal: true}},
		        tooltip: {x: { formatter: function(val) {return val;}}},
            };
            new ApexCharts(document.querySelector("#chart_divmh"), options1).render();
            const pieloai = @Html.Raw(ViewBag.pieloai);
            const piesll = @Html.Raw(ViewBag.piesll);
            var options3 = {
                chart: { type: 'pie', fontFamily: 'Verdana, sans-serif', height: 307 },
                series: piesll,
                labels: pieloai,
            };
        new ApexCharts(document.querySelector("#chart_divlmh"), options3).render();
        var options4 = {
            chart: {
                type: 'line', fontFamily: 'Verdana, sans-serif', height: 600, toolbar: { tools: { selection: false, zoom: false, zoomin: false, zoomout: false, pan: false, reset: false } },
                zoom: { enabled: false }
            },
            series: @Html.Raw(ViewBag.series),
            xaxis: {
                categories: @Html.Raw(ViewBag.ltk),
            },
            yaxis: {
                title: {
                    text: 'Số Lượng Tồn'
                },
                labels: {
                    formatter: function (val) { return val.toLocaleString('vi-VN')}
                }
            },
            stroke: {
                width: 3,
                curve: 'straight'
            },
            markers: {
                size: 5
            },
            dataLabels: {
                enabled: false
            },
            tooltip: {
                y: { formatter: function (val) { return val.toLocaleString('vi-VN')} }
            },
            legend: {
                position: 'top'
            }
        };
        new ApexCharts(document.querySelector("#chart_divthang"), options4).render();
    });
    </script>
}
<div class="container">
    <div class="page-inner">
        <div class="row">
            <div class="d-flex col-md-9 align-items-left align-items-md-center flex-column flex-md-row pt-2 pb-4">
                <div style="vertical-align: middle">
                    <h3 class="fw-bold mb-3">Thống kê tồn kho</h3>
                </div>
            </div>
            <div class="col-md-3" style="text-align: right; vertical-align: middle">
                @Html.ActionLink("Quay Lại", "Index")
            </div>
        </div>
        <div class="row row-card-no-pd">
            <div class="col-12 col-sm-6 col-md-6 col-xl-4">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between" style="align-items:center">
                            <div>
                                <h6><b>Tổng số lượng tồn kho</b></h6>
                            </div>
                            <h5 class="text-info fw-bold">@ViewBag.slt Mặt hàng</h5>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-md-6 col-xl-4">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between" style="align-items:center">
                            <div>
                                <h6><b>Số lượng mặt hàng mới nhập</b></h6>
                            </div>
                            <h5 class="text-success fw-bold">@ViewBag.slnm Mặt hàng</h5>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-md-6 col-xl-4">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between" style="align-items:center">
                            <div>
                                <h6><b>Số mặt hàng hết hàng</b></h6>
                            </div>
                            <h5 class="text-danger fw-bold">@ViewBag.hh Mặt hàng</h5>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="col-md-7">
                <div class="card">
                    <div class="card-header"><h5>Biểu Đồ 5 Mặt Hàng Tồn Kho Nhiều Nhất</h5></div>
                    <div class="card-body">
                        <div id="chart_divmh" style="width: 100%; height:300px; max-width:100%; margin:auto"></div>
                    </div>
                </div>
            </div>
            <div class="col-md-5">
                <div class="card">
                    <div class="card-header"><h5>Biểu Đồ Số Lượng Tồn Theo Loại Mặt Hàng</h5></div>
                    <div class="card-body">
                        <div id="chart_divlmh" style="width: 100%; height:315px; max-width:100%; margin:auto"></div>
                    </div>
                </div>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <div class="row">
                            <div class="col-md-12">
                                <p style="font-size: 1.25rem;text-align:center;min-width: 100%;margin-bottom:0px">
                                    Biểu Đồ Thể Hiện Số Lượng Tồn Của Từng Loại Mặt Hàng Theo Từng Tháng
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div id="chart_divthang" style="width: 100%; height:300px; max-width:100%; margin:auto"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@model WebBanTraiCay.Models.nhacungcap

@{
    ViewBag.Title = "Chi Tiết Nhà Cung Cấp";
}
<style>
    .dl-horizontal dt {
        float: left;
        width: 180px;
        font-weight: bold;
    }
    .dl-horizontal dd {
        margin-left: 200px;
        margin-bottom: 10px;
    }
</style>
<h2>Thông Tin Nhà Cung Cấp</h2>

<div class="row" style="font-family:Arial, sans-serif;font-size:20px;align-items:center">
    <h4>Nhà Cung Cấp</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>
            Tên Nhà Cung Cấp
        </dt>

        <dd>
            @Html.DisplayFor(model => model.tenncc)
        </dd>

        <dt>
            Địa Chỉ
        </dt>

        <dd>
            @Html.DisplayFor(model => model.diachi)
        </dd>

        <dt>
            Điện Thoại
        </dt>

        <dd>
            @Html.DisplayFor(model => model.dienthoai)
        </dd>
    </dl>
</div>
<p>
    @Html.ActionLink("Chỉnh Sửa", "Edit", new { id = Model.mancc }) |
    @Html.ActionLink("Quay Lại", "Index")
</p>

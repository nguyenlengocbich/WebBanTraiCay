@model IEnumerable<WebBanTraiCay.Models.nhacungcap>
        @if (Model.Count() != 0)
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.mancc)
                    </td>
                    <td class="col-wrap">
                        @Html.DisplayFor(modelItem => item.tenncc)
                    </td>
                    <td class="col-wrap">
                        @Html.DisplayFor(modelItem => item.diachi)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.dienthoai)
                    </td>
                    <td class="col-actions">
                        @Html.ActionLink("Cập Nhật", "Edit", new { id = item.mancc }, new { @class = "btn btn-primary" }) |
                        @Html.ActionLink("Chi Tiết", "Details", new { id = item.mancc }, new { @class = "btn btn-info" }) |
                        @Html.ActionLink("Xóa", "Delete", new { id = item.mancc }, new { @class = "btn btn-danger btn-delete", data_role = ViewBag.role })
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5">Không có dữ liệu</td>
            </tr>
        }
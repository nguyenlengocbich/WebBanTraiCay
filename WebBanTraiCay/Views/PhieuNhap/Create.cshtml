@model WebBanTraiCay.Models.phieunhap
@{
    ViewBag.Title = "Tạo phiếu nhập mới";
}
<style>
    .form-group {
        padding-left: 20%;
        padding-right: 20%;
        align-items: center;
    }
    .form-horizontal {
        font-size: 20px;
    }
    .form-horizontal .col-md-9 .form-control {
        width: 80% !important;
        box-sizing: border-box;
        max-width: 80% !important;
    }
    .custom-inline {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }
    .custom-inline .form-control {
        width: auto;
        min-width: 100px;
    }
    .custom-row {
        padding-left: 15%;
        padding-right: 15%;
        align-items: center;
    }
    .custom-inline select {
        width: 250px;
    }
    .custom-inline label {
        margin-right: 10px;
        white-space: nowrap;
    }
</style>
<h2>Thêm Phiếu Nhập Mới</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal" style="background-color:cornsilk">
        <h4 style="text-align:center;padding-top:10px">Thông tin phiếu nhập </h4>
        <hr />

        <div class="form-group row mb-3">
            <label class="control-label col-md-3">Nhà cung cấp</label>
            <div class="col-md-9">
                @Html.DropDownListFor(m => m.mancc, (SelectList)ViewBag.ncc, new { @class = "form-control", style = "width:600px;" })
            </div>
        </div>

        <div class="form-group row mb-3">
            <label class="control-label col-md-3">Ngày lập phiếu nhập</label>
            <div class="col-md-9">
                <input type="date" name="ngaynhap" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
            </div>
        </div>

        <div class="form-group row mb-3">
            <label class="control-label col-md-3">Nhân viên lập</label>
            <div class="col-md-9">
                <input type="text" name="manv" value="@ViewBag.nv" readonly class="form-control" />
            </div>
        </div>

        <hr />
        <h4 style="text-align:center;padding-top:10px">Chi tiết mặt hàng</h4>
        <div class="form-inline custom-inline">
            <label class="control-label">Mặt hàng</label>
            <select id="mamh" class="form-control">
                @foreach (var sp in ViewBag.mathang as List<WebBanTraiCay.Models.mathang>)
                {
                    <option value="@sp.mamh">@sp.tenmh</option>
                }
            </select>
            <input type="number" id="soluong" class="form-control" placeholder="Số lượng" min="1" />
            <input type="number" id="dongia" class="form-control" placeholder="Đơn giá" min="1" />
            <button type="button" id="btnAdd" class="btn btn-success">Thêm mặt hàng</button>
        </div>

        <br />
        <table class="table table-bordered" id="tblChiTiet">
            <thead>
                <tr>
                    <th>Mặt hàng</th>
                    <th>Số lượng</th>
                    <th>Đơn giá</th>
                    <th>Thành tiền</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
        <div id="hiddenInputs"></div>
        <div class="form-group row mb-3" style="align-items:center;padding-bottom:20px">
            <div class="col-md-5"></div>
            <div class="col-md-offset-2 col-md-7">
                <input style="font-size:20px" type="submit" value="Tạo Phiếu Nhập" class="btn btn-success" />
            </div>
        </div>
    </div>
}
<div>
    @Html.ActionLink("Quay lại danh sách", "Index")
</div>
@section scripts {
    <script>
        let count = 0;
        document.getElementById("btnAdd").addEventListener("click", function () {
            const select = document.getElementById("mamh");
            const mamh = select.value;
            const tensp = select.options[select.selectedIndex].text;
            const dongia = parseInt(document.getElementById("dongia").value);
            const soluong = parseInt(document.getElementById("soluong").value);
            if (!mamh || isNaN(soluong) || soluong <= 0 || isNaN(dongia) || dongia <= 0) {
                alert("Vui lòng chọn sản phẩm, nhập số lượng và đơn giá hợp lệ!");
                return;
            }
            const check = document.querySelector(`input[name='mamh'][value='${mamh}']`);
            if (check) {
                alert("Mặt hàng này đã được thêm trong danh sách!");
                return;
            }
            const thanhtien = dongia * soluong;
            const row = `
                            <tr id="row_${count}">
                                <td>${tensp}</td>
                                <td>${soluong}</td>
                                <td>${dongia.toString()}</td>
                                <td>${thanhtien.toString()}</td>
                                <td>
                                    <button type="button" class="btn btn-danger btn-sm" onclick="xoa(${count})">Xóa</button>
                                </td>
                            </tr>`;
            document.querySelector("#tblChiTiet tbody").insertAdjacentHTML("beforeend", row);
            const hidden = `
                            <input type="hidden" name="mamh" value="${mamh}" id="mamh_${count}" />
                            <input type="hidden" name="soluong" value="${soluong}" id="soluong_${count}" />
                            <input type="hidden" name="dongia" value="${dongia}" id="dongia_${count}" />`;
            document.getElementById("hiddenInputs").insertAdjacentHTML("beforeend", hidden);
            count++;
        });
        function xoa(id) {
            const row = document.getElementById("row_" + id);
            if (row) row.remove();
            const m = document.getElementById("mamh_" + id);
            const s = document.getElementById("soluong_" + id);
            const dgn = document.getElementById("dongia_" + id);
            if (m) m.remove();
            if (s) s.remove();
            if (dgn) dgn.remove();
        }
    </script>
}
